      "source": [
        "```{r}\n",
        "library(ggplot2)\n",
        "library(dplyr)\n",
        "library(scales)\n",
        "\n",
        "# 1. Summarize to get counts, then calculate percentage\n",
        "plot_data = df %>%\n",
        "  count(writing_rating) %>%\n",
        "  mutate(pct = n / sum(n))\n",
        "\n",
        "df_percentage <- df %>%\n",
        "  group_by(writing_rating) %>%\n",
        "  summarise(pct_nw5 = mean(is_nw5 == 1))\n",
        "# 2. Create the plot\n",
        "ggplot(df_percentage, aes(x = writing_rating, y = pct_nw5)) +\n",
        "  geom_col(fill = \"red3\") +\n",
        "  geom_text(aes(label = scales::percent(pct_nw5)), vjust = -0.5) + # Adds text labels\n",
        "  scale_y_continuous(labels = scales::percent) +                # Formats y-axis\n",
        "  labs(x = \"Category\", y = \"Percent of Total\")\n",
        "\n",
        "```\n",
        "\n",
        "\n",
        "```{r}\n",
        "df_percent <- df %>%\n",
        "  group_by(writing_rating,testing_plan) %>%\n",
        "  summarise(value = sum(is_nw5), total=n()) %>%\n",
        "  mutate(\n",
        "    total2 = sum(value),\n",
        "    percent = value / total\n",
        "  ) %>%\n",
        "  drop_na(testing_plan)\n",
        "\n",
        "ggplot(df_percent, aes(x = writing_rating, fill = factor(testing_plan), y=percent)) +\n",
        "  geom_col(position = position_dodge()) +\n",
        "  scale_y_continuous(labels = scales::percent) +\n",
        "  theme_minimal() +\n",
        "  labs(\n",
        "    title = \"Percentage of Applicants attending Northwest 5 schools by testing plan and Writing Rating\",\n",
        "    subtitle = \"Split by Writing Rating and Testing Plan\",\n",
        "    x = \"Writing Rating\",\n",
        "    y = \"Percentage of students attending a Northwest 5 school\",\n",
        "    fill = \"Submitted Test Scores\"\n",
        "  )+\n",
        "  scale_fill_manual(values=c(\"red3\", \"yellow\"), labels=c(\"Submitted\", \"Did not submit\") )\n",
        "```\n",
        "\n",
        "\n",
