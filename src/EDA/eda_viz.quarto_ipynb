        "\n",
        "```{r}\n",
        "#this graph will look at the combined GPA \n",
        "df_loc = df %>%\n",
        "    mutate(school_loc = case_when(\n",
        "        is_nw5==1 ~ \"NW 5\",\n",
        "        is_large_public==1 ~ \"Large Public\",\n",
        "        dest_other==1 ~ \"Other\"\n",
        "        ), \n",
        "        combo_gpa = case_when(\n",
        "          !is.na(app_transfer_gpa) & is.na(app_unweighted_gpa) ~ app_transfer_gpa +1 ,\n",
        "          is.na(app_transfer_gpa) & !is.na(app_weighted_gpa) ~ app_weighted_gpa,\n",
        "          !is.na(app_weighted_gpa) & !is.na(app_transfer_gpa) ~ (((app_transfer_gpa+1)+ app_weighted_gpa) /2)\n",
        "        )) %>% \n",
        "    mutate(combo_gpa = cut(combo_gpa, breaks = c(2,2.5,2.75,3,3.25,3.5,3.75,4, 4.25,4.5,4.75,5), right = FALSE)) %>%\n",
        "        #mutate(unweight_gpa = cut(unweight_gpa, breaks=8)) %>%\n",
        "    drop_na(combo_gpa, school_loc) %>% \n",
        "    group_by(combo_gpa, school_loc) %>% \n",
        "    summarise(subtotal = n(), .groups = \"drop_last\") %>% \n",
        "    mutate(total_by_var1 = sum(subtotal),\n",
        "          percent = subtotal/total_by_var1) %>%\n",
        "    mutate(school_loc = fct_reorder(school_loc, percent, .fun = identity, .desc=TRUE))\n",
        "          #filtering out the \"other schools\"\n",
        "          #filter(school_loc == 'Large Public' | school_loc == 'NW 5') \n",
        "    print(df_loc)\n",
        "    ggplot(data=df_loc,aes(x=combo_gpa, y=percent,fill=school_loc)) + geom_col( position=\"dodge\") +\n",
        "    scale_y_continuous(labels = scales::percent) +\n",
        "    #scale_x_discrete(labels = c(\"0\" = \"Not First Generation\", \"1\" = \"First Generation\")) +\n",
        "    labs (\n",
        "      x= \"Applicant Unweighted GPA\",\n",
        "      y = \"Percentage of Students\",\n",
        "      fill = \"Attended School Category\"\n",
        "      )+ geom_text(aes(label = round(percent*100,2)), vjust = -.5, position = position_dodge(width=0.9))\n",
        "```\n",
